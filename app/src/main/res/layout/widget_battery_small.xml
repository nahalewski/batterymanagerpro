<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Charging battery sprite indicator -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginEnd="10dp">

        <ImageView
            android:id="@+id/widget_battery_icon"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:src="@drawable/widget_batt_80"
            android:scaleType="fitCenter"
            android:contentDescription="Battery Level" />

        <TextView
            android:id="@+id/widget_battery_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="80%"
            android:textColor="#00DCFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Compact Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_device_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Battery"
            android:textColor="#EEF8FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Live"
            android:textColor="#00F5AA"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/widget_power_compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="42W OUT"
                android:textColor="#00DCFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/widget_pill_out_bg"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
