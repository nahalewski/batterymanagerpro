<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Top Left Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Battery Manager Pro"
        android:textColor="#00DCFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.04"
        android:layout_marginBottom="3dp" />

    <!-- Content Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Battery graphic and percentage -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/widget_battery_icon"
                android:layout_width="40dp"
                android:layout_height="44dp"
                android:src="@drawable/widget_batt_80"
                android:scaleType="fitCenter"
                android:contentDescription="Battery Level" />

            <TextView
                android:id="@+id/widget_battery_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="80%"
                android:textColor="#00DCFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Center / Right Telemetry Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <!-- Device Header & Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_device_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="20K Prime Power Bank"
                    android:textColor="#EEF8FF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Connected"
                    android:textColor="#00F5AA"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Power In / Out badges -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical">

                <!-- Input badge -->
                <TextView
                    android:id="@+id/widget_input_watts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IN  0W"
                    android:textColor="#70EBFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/widget_pill_in_bg"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_marginEnd="6dp" />

                <!-- Output badge -->
                <TextView
                    android:id="@+id/widget_output_watts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OUT  42W"
                    android:textColor="#00DCFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/widget_pill_out_bg"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_extra_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="28.0°C  •  2h 15m remaining"
                android:textColor="#8EB0C2"
                android:textSize="10sp"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
