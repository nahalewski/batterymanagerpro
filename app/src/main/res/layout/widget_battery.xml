<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Battery graphic and percentage -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginEnd="14dp">

        <ImageView
            android:id="@+id/widget_battery_icon"
            android:layout_width="48dp"
            android:layout_height="52dp"
            android:src="@drawable/widget_batt_80"
            android:scaleType="fitCenter"
            android:contentDescription="Battery Level" />

        <TextView
            android:id="@+id/widget_battery_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="80%"
            android:textColor="#00DCFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Center / Right Telemetry Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- Device Header & Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_device_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Battery Manager"
                android:textColor="#EEF8FF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Connected"
                android:textColor="#00F5AA"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Power In / Out badges -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <!-- Input badge -->
            <LinearLayout
                android:id="@+id/widget_input_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/widget_pill_in_bg"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:id="@+id/widget_input_watts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IN  65.0W"
                    android:textColor="#00E676"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Output badge -->
            <LinearLayout
                android:id="@+id/widget_output_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/widget_pill_out_bg"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/widget_output_watts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OUT  18.5W"
                    android:textColor="#29B6F6"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Extra info (temp, remaining time, last updated) -->
        <TextView
            android:id="@+id/widget_extra_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap to open app"
            android:textColor="#8EB0C2"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="5dp" />
    </LinearLayout>
</LinearLayout>
