<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fleet_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_pill_in_bg"
    android:paddingStart="10dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp">

    <!-- Battery Hardware Thumbnail -->
    <ImageView
        android:id="@+id/fleet_item_img"
        android:layout_width="38dp"
        android:layout_height="44dp"
        android:src="@drawable/prime_20k"
        android:scaleType="fitCenter"
        android:contentDescription="Battery Model"
        android:layout_marginEnd="10dp" />

    <!-- Name & Status -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/fleet_item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="20K Prime Power Bank"
            android:textColor="#EEF8FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/fleet_item_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Live"
                android:textColor="#00F5AA"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/fleet_item_power"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="42W OUT"
                android:textColor="#70EBFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Battery Percentage Badge -->
    <TextView
        android:id="@+id/fleet_item_pct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="88%"
        android:textColor="#00DCFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:gravity="end"
        android:layout_marginStart="8dp" />
</LinearLayout>
