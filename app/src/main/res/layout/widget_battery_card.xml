<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- 3D Hardware Display with glowing backdrop -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginEnd="16dp">

        <ImageView
            android:id="@+id/widget_card_img"
            android:layout_width="96dp"
            android:layout_height="match_parent"
            android:src="@drawable/prime_20k"
            android:scaleType="fitCenter"
            android:contentDescription="Battery Hardware Showcase" />

        <!-- Live Battery percentage badge -->
        <TextView
            android:id="@+id/widget_card_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:text="88%"
            android:textColor="#00DCFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/widget_pill_in_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginBottom="2dp" />
    </FrameLayout>

    <!-- Detailed Hardware Telemetry -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- Brand & Model Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_card_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ANKER"
                android:textColor="#00DCFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/widget_pill_in_bg"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/widget_card_model"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="20K Prime Power Bank"
                android:textColor="#EEF8FF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Connection & Signal status -->
        <TextView
            android:id="@+id/widget_card_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Live Telemetry Stream"
            android:textColor="#00F5AA"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="3dp" />

        <!-- Power Flow Tiles (Input & Output) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/widget_pill_in_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INPUT"
                    android:textColor="#70EBFF"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_card_input_w"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0 W"
                    android:textColor="#EEF8FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/widget_pill_out_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OUTPUT"
                    android:textColor="#00DCFF"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_card_output_w"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="42.5 W"
                    android:textColor="#EEF8FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Extra Hardware Info (Temp & Time Remaining) -->
        <TextView
            android:id="@+id/widget_card_extra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="28.0°C  •  2h 15m remaining"
            android:textColor="#8EB0C2"
            android:textSize="11sp"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
