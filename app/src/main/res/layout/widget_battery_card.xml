<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Top Left Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Battery Manager Pro"
        android:textColor="#00DCFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.04"
        android:layout_marginBottom="4dp" />

    <!-- Main Content Horizontal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 3D Hardware Display with glowing backdrop -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="14dp">

            <ImageView
                android:id="@+id/widget_card_img"
                android:layout_width="90dp"
                android:layout_height="match_parent"
                android:src="@drawable/prime_20k"
                android:scaleType="fitCenter"
                android:contentDescription="Battery Hardware Showcase" />

            <!-- Live Battery percentage badge -->
            <TextView
                android:id="@+id/widget_card_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:text="88%"
                android:textColor="#00DCFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/widget_pill_in_bg"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginBottom="2dp" />
        </FrameLayout>

        <!-- Detailed Hardware Telemetry -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <!-- Brand & Model Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_card_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ANKER"
                    android:textColor="#00DCFF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:background="@drawable/widget_pill_in_bg"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/widget_card_model"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="20K Prime Power Bank"
                    android:textColor="#EEF8FF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Connection & Signal status -->
            <TextView
                android:id="@+id/widget_card_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Live Telemetry Stream"
                android:textColor="#00F5AA"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

            <!-- Power Flow Tiles (Input & Output) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/widget_pill_in_bg"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_marginEnd="5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INPUT"
                        android:textColor="#70EBFF"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_card_input_w"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0 W"
                        android:textColor="#EEF8FF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/widget_pill_out_bg"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OUTPUT"
                        android:textColor="#00DCFF"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_card_output_w"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="42.5 W"
                        android:textColor="#EEF8FF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Extra Hardware Info (Temp & Time Remaining) -->
            <TextView
                android:id="@+id/widget_card_extra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="28.0°C  •  2h 15m remaining"
                android:textColor="#8EB0C2"
                android:textSize="10sp"
                android:layout_marginTop="5dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
